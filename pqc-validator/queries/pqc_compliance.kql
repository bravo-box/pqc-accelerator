// =============================================================================
// PQC Compliance — Log Analytics KQL Queries
//
// Table  : PQCCompliance_CL  (Log Analytics Data Collector API — legacy custom log)
//
// Column reference (normalized view)
// ─────────────────────────────────────────────────────────────────────────────
// TimeGenerated        datetime   machine event timestamp (scan/check/gap time)
//                                ingestion time remains available via built-in _TimeReceived
// IngestionTime        datetime   stamped in DCR transform at ingestion time
// record_type_s        string     scan_result | compliance_gap | error
// hostname_s           string     Arc machine hostname
// platform_s           string     Linux | Windows | Darwin
// os_version_s         string     distro/build string
// check_name_s         string     e.g. "OpenSSL Version Check"
// category_s           string     crypto_library | crypto_algorithms |
//                                 tls_configuration | certificates |
//                                 ssh | system_security | encryption
// status_s             string     COMPLIANT | DEPRECATED | NOT_FOUND |
//                                 REQUIRES_UPDATE | UNKNOWN | ERROR
// details_s            string     human-readable check output
// algorithm_s          string     e.g. "OpenSSL"
// version_s            string     detected version
// gap_type_s           string     deprecated_openssl | no_pqc_algorithms |
//                                 deprecated_protocols | weak_ciphers_available |
//                                 deprecated_ssh_algorithms | fips_not_enabled |
//                                 weak_root_certificates
// severity_s           string     CRITICAL | HIGH | MEDIUM | LOW  (gaps only)
// affected_component_s string     component name (gaps only)
// recommendation_s     string     remediation guidance (gaps only)
// priority_score_d     real       0.0–1.0 remediation priority (gaps only)
// error_type_s         string     error category (errors only)
// scan_run_id_s        string     unique validator execution id
// record_hash_s        string     deterministic deduplication key
// =============================================================================

// Compatibility normalization:
// - New DCR/table schema: snake_case (record_type, hostname, ...)
// - Legacy Data Collector schema: _s/_d suffixes (record_type_s, priority_score_d, ...)
// - Historical DCR schema: PascalCase custom columns (RecordType, MachineName, ...)
let pqc_records = () {
  PQCCompliance_CL
  | extend
    IngestionTime = coalesce(
      todatetime(column_ifexists("IngestionTime", datetime(null))),
      todatetime(column_ifexists("ingestion_time", datetime(null))),
      _TimeReceived
    ),
    record_type_s = coalesce(tostring(column_ifexists("record_type_s", "")), tostring(column_ifexists("record_type", "")), tostring(column_ifexists("RecordType", ""))),
    hostname_s = coalesce(tostring(column_ifexists("hostname_s", "")), tostring(column_ifexists("hostname", "")), tostring(column_ifexists("MachineName", ""))),
    platform_s = coalesce(tostring(column_ifexists("platform_s", "")), tostring(column_ifexists("platform", "")), tostring(column_ifexists("Platform", ""))),
    os_version_s = coalesce(tostring(column_ifexists("os_version_s", "")), tostring(column_ifexists("os_version", "")), tostring(column_ifexists("OSVersion", ""))),
    check_name_s = coalesce(tostring(column_ifexists("check_name_s", "")), tostring(column_ifexists("check_name", "")), tostring(column_ifexists("CheckName", ""))),
    category_s = coalesce(tostring(column_ifexists("category_s", "")), tostring(column_ifexists("category", "")), tostring(column_ifexists("Category", ""))),
    status_s = coalesce(tostring(column_ifexists("status_s", "")), tostring(column_ifexists("status", "")), tostring(column_ifexists("Status", ""))),
    details_s = coalesce(tostring(column_ifexists("details_s", "")), tostring(column_ifexists("details", "")), tostring(column_ifexists("Details", ""))),
    gap_type_s = coalesce(tostring(column_ifexists("gap_type_s", "")), tostring(column_ifexists("gap_type", "")), tostring(column_ifexists("GapType", ""))),
    severity_s = coalesce(tostring(column_ifexists("severity_s", "")), tostring(column_ifexists("severity", "")), tostring(column_ifexists("Severity", ""))),
    affected_component_s = coalesce(tostring(column_ifexists("affected_component_s", "")), tostring(column_ifexists("affected_component", "")), tostring(column_ifexists("AffectedComponent", ""))),
    recommendation_s = coalesce(tostring(column_ifexists("recommendation_s", "")), tostring(column_ifexists("recommendation", "")), tostring(column_ifexists("Recommendation", ""))),
    algorithm_s = coalesce(tostring(column_ifexists("algorithm_s", "")), tostring(column_ifexists("algorithm", "")), tostring(column_ifexists("Algorithm", ""))),
    version_s = coalesce(tostring(column_ifexists("version_s", "")), tostring(column_ifexists("version", "")), tostring(column_ifexists("Version", ""))),
    error_type_s = coalesce(tostring(column_ifexists("error_type_s", "")), tostring(column_ifexists("error_type", "")), tostring(column_ifexists("ErrorType", ""))),
    scan_run_id_s = coalesce(tostring(column_ifexists("scan_run_id_s", "")), tostring(column_ifexists("scan_run_id", "")), tostring(column_ifexists("ScanRunId", ""))),
    record_hash_s = coalesce(tostring(column_ifexists("record_hash_s", "")), tostring(column_ifexists("record_hash", "")), tostring(column_ifexists("RecordHash", ""))),
    priority_score_d = todouble(coalesce(
      column_ifexists("priority_score_d", real(null)),
      column_ifexists("priority_score", real(null)),
      column_ifexists("PriorityScore", real(null)),
      0.0
    ))
};


// ── 1. Fleet compliance score per machine (last 24 h) ────────────────────────
pqc_records()
| where TimeGenerated > ago(24h)
| where record_type_s == "scan_result"
| extend dedup_key = iff(
  isempty(tostring(record_hash_s)),
  strcat(hostname_s, "|", record_type_s, "|", check_name_s, "|", status_s, "|", details_s),
  tostring(record_hash_s)
)
| summarize arg_max(TimeGenerated, *) by dedup_key
| summarize
    TotalChecks = count(),
    Compliant   = countif(status_s == "COMPLIANT"),
    Deprecated  = countif(status_s == "DEPRECATED"),
    NeedsUpdate = countif(status_s == "REQUIRES_UPDATE"),
    NotFound    = countif(status_s == "NOT_FOUND")
  by hostname_s, platform_s, os_version_s
| extend ComplianceScore = round(100.0 * Compliant / TotalChecks, 1)
| order by ComplianceScore asc


// ── 2. Active compliance gaps — fleet-wide (last 24 h) ───────────────────────
pqc_records()
| where TimeGenerated > ago(24h)
| where record_type_s == "compliance_gap"
| extend dedup_key = iff(
  isempty(tostring(record_hash_s)),
  strcat(hostname_s, "|", record_type_s, "|", gap_type_s, "|", severity_s, "|", affected_component_s, "|", details_s),
  tostring(record_hash_s)
)
| summarize arg_max(TimeGenerated, *) by dedup_key
| summarize
    MachineCount     = dcount(hostname_s),
    MachinesAffected = make_set(hostname_s)
  by gap_type_s, severity_s, affected_component_s, recommendation_s
| order by
    case(severity_s, "CRITICAL", 4, "HIGH", 3, "MEDIUM", 2, "LOW", 1, 0) desc,
    MachineCount desc


// ── 3. Machines with CRITICAL or HIGH gaps ───────────────────────────────────
pqc_records()
| where TimeGenerated > ago(24h)
| where record_type_s == "compliance_gap"
| where severity_s in ("CRITICAL", "HIGH")
| extend dedup_key = iff(
  isempty(tostring(record_hash_s)),
  strcat(hostname_s, "|", record_type_s, "|", gap_type_s, "|", severity_s, "|", affected_component_s, "|", details_s),
  tostring(record_hash_s)
)
| summarize arg_max(TimeGenerated, *) by dedup_key
| summarize
    CriticalGaps = countif(severity_s == "CRITICAL"),
    HighGaps     = countif(severity_s == "HIGH"),
    GapTypes     = make_set(gap_type_s)
  by hostname_s, platform_s
| order by CriticalGaps desc, HighGaps desc


// ── 4. PQC algorithm coverage ────────────────────────────────────────────────
pqc_records()
| where TimeGenerated > ago(24h)
| where record_type_s == "scan_result"
| where check_name_s == "libcrypto Algorithm Check"
| project TimeGenerated, hostname_s, platform_s, os_version_s, status_s, details_s
| order by status_s asc, hostname_s asc


// ── 5. OpenSSL version distribution ─────────────────────────────────────────
pqc_records()
| where TimeGenerated > ago(24h)
| where record_type_s == "scan_result"
| where check_name_s == "OpenSSL Version Check"
| extend dedup_key = iff(
  isempty(tostring(record_hash_s)),
  strcat(hostname_s, "|", record_type_s, "|", check_name_s, "|", version_s, "|", status_s),
  tostring(record_hash_s)
)
| summarize arg_max(TimeGenerated, *) by dedup_key
| summarize
    MachineCount = dcount(hostname_s),
    Machines     = make_set(hostname_s)
  by version_s, status_s
| order by version_s desc


// ── 6. TLS and SSH deprecation exposure ──────────────────────────────────────
pqc_records()
| where TimeGenerated > ago(24h)
| where record_type_s == "scan_result"
| where category_s in ("tls_configuration", "ssh")
| where status_s in ("DEPRECATED", "REQUIRES_UPDATE")
| project TimeGenerated, hostname_s, platform_s, check_name_s, category_s, status_s, details_s
| order by hostname_s asc, category_s asc


// ── 7. Certificate store issues ──────────────────────────────────────────────
pqc_records()
| where TimeGenerated > ago(24h)
| where record_type_s == "scan_result"
| where category_s == "certificates"
| where status_s != "COMPLIANT"
| project TimeGenerated, hostname_s, platform_s, check_name_s, status_s, details_s
| order by status_s desc, hostname_s asc


// ── 8. FIPS compliance status ────────────────────────────────────────────────
pqc_records()
| where TimeGenerated > ago(24h)
| where check_name_s == "OpenSSL FIPS Module Check"
    or gap_type_s == "fips_not_enabled"
| project TimeGenerated, hostname_s, platform_s, record_type_s, check_name_s, gap_type_s, status_s, details_s
| order by hostname_s asc


// ── 9. Compliance gap trend over time ────────────────────────────────────────
pqc_records()
| where record_type_s == "compliance_gap"
| where TimeGenerated > ago(30d)
| extend dedup_key = iff(
  isempty(tostring(record_hash_s)),
  strcat(hostname_s, "|", record_type_s, "|", gap_type_s, "|", severity_s, "|", affected_component_s, "|", details_s),
  tostring(record_hash_s)
)
| summarize arg_max(TimeGenerated, *) by dedup_key
| summarize GapCount = count() by bin(TimeGenerated, 1d), severity_s
| order by TimeGenerated asc


// ── 10. Scan coverage — machines reporting in last 7 days ───────────────────
pqc_records()
| where TimeGenerated > ago(7d)
| extend dedup_key = iff(
  isempty(tostring(record_hash_s)),
  strcat(hostname_s, "|", record_type_s, "|", check_name_s, "|", status_s, "|", details_s),
  tostring(record_hash_s)
)
| summarize arg_max(TimeGenerated, *) by dedup_key
| summarize
    LastScan  = max(TimeGenerated),
    ScanCount = dcount(bin(TimeGenerated, 1d))
  by hostname_s, platform_s, os_version_s
| order by LastScan desc


// ── 11. Stale machines — no scan data in last 48 h ──────────────────────────
pqc_records()
| summarize LastScan = max(TimeGenerated) by hostname_s, platform_s
| where LastScan < ago(48h)
| order by LastScan asc


// ── 12. Validator errors ─────────────────────────────────────────────────────
pqc_records()
| where record_type_s == "error"
| where TimeGenerated > ago(7d)
| extend dedup_key = iff(
    isempty(tostring(record_hash_s)),
    strcat(hostname_s, "|", record_type_s, "|", error_type_s, "|", details_s),
    tostring(record_hash_s)
)
| summarize arg_max(TimeGenerated, *) by dedup_key
| summarize ErrorCount = count(), LastSeen = max(TimeGenerated)
  by hostname_s, error_type_s, details_s
| order by ErrorCount desc


// ── 13. Executive dashboard — fleet-wide summary (last 24 h) ─────────────────
let Checks = pqc_records()
    | where TimeGenerated > ago(24h)
    | where record_type_s == "scan_result"
  | extend dedup_key = iff(
    isempty(tostring(record_hash_s)),
    strcat(hostname_s, "|", record_type_s, "|", check_name_s, "|", status_s, "|", details_s),
    tostring(record_hash_s)
  )
  | summarize arg_max(TimeGenerated, *) by dedup_key
    | summarize
        TotalChecks     = count(),
        CompliantChecks = countif(status_s == "COMPLIANT"),
        TotalMachines   = dcount(hostname_s);
let Gaps = pqc_records()
    | where TimeGenerated > ago(24h)
    | where record_type_s == "compliance_gap"
  | extend dedup_key = iff(
    isempty(tostring(record_hash_s)),
    strcat(hostname_s, "|", record_type_s, "|", gap_type_s, "|", severity_s, "|", affected_component_s, "|", details_s),
    tostring(record_hash_s)
  )
  | summarize arg_max(TimeGenerated, *) by dedup_key
    | summarize
        CriticalGaps = countif(severity_s == "CRITICAL"),
        HighGaps     = countif(severity_s == "HIGH"),
        TotalGaps    = count();
Checks | cross join Gaps
| project
    TotalMachines,
    TotalChecks,
    CompliantChecks,
    FleetScore   = round(100.0 * CompliantChecks / TotalChecks, 1),
    TotalGaps,
    CriticalGaps,
    HighGaps


// ── 14. Per-machine full check roster ────────────────────────────────────────
// Replace <machine-hostname> before running
pqc_records()
| where TimeGenerated > ago(24h)
| where record_type_s == "scan_result"
| where hostname_s == "<machine-hostname>"
| project TimeGenerated, check_name_s, category_s, status_s, version_s, algorithm_s, details_s
| order by category_s asc, check_name_s asc


// ── 15. Ingestion lag and scan cadence (last 7 days) ─────────────────────────
// Shows machine event time vs ingestion time and interval between scans.
pqc_records()
| where TimeGenerated > ago(7d)
| where record_type_s == "scan_result"
| summarize arg_max(TimeGenerated, *) by hostname_s, check_name_s
| summarize LastScanAt = max(TimeGenerated), LastIngestAt = max(IngestionTime) by hostname_s
| order by hostname_s asc
